{
  "name": "portfolio-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vinext dev --port 13001",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:cloudflare": "vinext build && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@packages/metadata": "workspace:*",
    "@packages/ui-w": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "5.102.8",
    "@thesvg/react": "^3.3.8",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@packages/typescript": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "@cloudflare/vite-plugin": "1.54.7",
    "wrangler": "4.131.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
