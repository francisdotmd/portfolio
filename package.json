{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:apps": "prettier --write \"apps/**/*.{ts,tsx,md}\"",
    "format:packages": "prettier --write \"packages/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean:next": "find apps -mindepth 2 -maxdepth 2 -type d -name .next -exec rm -rf {} +"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
