{
  "formatter": "prettier",
  "languages": {
    "Go": {
      "show_edit_predictions": true,
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },
    "Python": {
      "auto_indent": "syntax_aware",
    },
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/.expo/**",
    "**/dist/**",
    "**/.vinext/**",
  ],
}
